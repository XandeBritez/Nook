<Window x:Class="Nook.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook — Configurações" Width="540" Height="560"
        MinWidth="500" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <Color x:Key="DlgPanel">#252526</Color>
        <Color x:Key="DlgControl">#2D2D30</Color>
        <Color x:Key="DlgHover">#3E3E42</Color>
        <Color x:Key="DlgBorder">#3F3F46</Color>
        <Color x:Key="DlgAccent">#007ACC</Color>
        <Color x:Key="DlgAccentHover">#1C97EA</Color>
        <Color x:Key="DlgSelect">#094771</Color>
        <SolidColorBrush x:Key="DlgPanelB" Color="{StaticResource DlgPanel}"/>
        <SolidColorBrush x:Key="DlgControlB" Color="{StaticResource DlgControl}"/>
        <SolidColorBrush x:Key="DlgHoverB" Color="{StaticResource DlgHover}"/>
        <SolidColorBrush x:Key="DlgBorderB" Color="{StaticResource DlgBorder}"/>
        <SolidColorBrush x:Key="DlgAccentB" Color="{StaticResource DlgAccent}"/>
        <SolidColorBrush x:Key="DlgAccentHoverB" Color="{StaticResource DlgAccentHover}"/>
        <SolidColorBrush x:Key="DlgSelectB" Color="{StaticResource DlgSelect}"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DlgControlB}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DlgHoverB}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource DlgAccentB}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DlgControlB}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorderB}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="SelectionBrush" Value="{StaticResource DlgAccentB}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DlgAccentB}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource DlgHoverB}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource DlgSelectB}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource DlgControlB}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorderB}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="White" Opacity="0.8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                            </ContentPresenter>
                            <TextBox x:Name="PART_EditableTextBox" Background="Transparent"
                                     Foreground="White" CaretBrush="White" BorderThickness="0"
                                     Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                     Margin="0,0,24,0" Visibility="Collapsed"
                                     Text="{Binding Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource DlgPanelB}"
                                        BorderBrush="{StaticResource DlgBorderB}" BorderThickness="1"
                                        CornerRadius="4" SnapsToDevicePixels="True"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource DlgPanelB}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorderB}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DlgBorderB}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DlgHoverB}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DlgControlB}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource DlgBorderB}"/>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource DlgHoverB}"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="3"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E4E52"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{StaticResource DlgAccentB}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#4FC1FF"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs">
        <TabItem Header="Botões">
        <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de botões -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Botões" FontWeight="Bold" Margin="0,0,0,6" DockPanel.Dock="Top"/>
            <UniformGrid Rows="1" Columns="4" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="＋" ToolTip="Adicionar" Click="AddButton_Click" Margin="0,0,2,0" MinHeight="28" FontSize="13"/>
                <Button Content="－" ToolTip="Remover" Click="DelButton_Click" Margin="2,0,2,0" MinHeight="28" FontSize="13"/>
                <Button Content="▲" ToolTip="Mover para cima" Click="UpButton_Click" Margin="2,0,2,0" MinHeight="28" FontSize="13"/>
                <Button Content="▼" ToolTip="Mover para baixo" Click="DownButton_Click" Margin="2,0,0,0" MinHeight="28" FontSize="13"/>
            </UniformGrid>
            <ListBox x:Name="ShortcutListBox"
                     SelectionChanged="ShortcutListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Margin="0,2,0,8" TextChanged="FieldChanged"/>

                <TextBlock Text="Ícone (escolha ou cole um emoji)" FontWeight="Bold"/>
                <ComboBox x:Name="IconBox" Margin="0,2,0,8" IsEditable="True"
                          FontSize="16" MaxDropDownHeight="240"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="IconBox_SelectionChanged"
                          LostFocus="IconBox_LostFocus">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="Width" Value="38"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Text="Tipo" FontWeight="Bold"/>
                <ComboBox x:Name="TypeBox" Margin="0,2,0,8"
                          SelectionChanged="TypeBox_SelectionChanged">
                    <ComboBoxItem Content="Programa / comando"/>
                    <ComboBoxItem Content="Ação embutida do sistema"/>
                </ComboBox>

                <StackPanel x:Name="ProgramPanel">
                    <TextBlock Text="Arquivo / exe" FontWeight="Bold"/>
                    <TextBox x:Name="FileBox" Margin="0,2,0,8" TextChanged="FieldChanged"/>
                    <TextBlock Text="Argumentos" FontWeight="Bold"/>
                    <TextBox x:Name="ArgsBox" Margin="0,2,0,8" TextChanged="FieldChanged"/>
                    <TextBlock Text="Pasta inicial" FontWeight="Bold"/>
                    <TextBox x:Name="WorkDirBox" Margin="0,2,0,8" TextChanged="FieldChanged"/>
                    <TextBlock Text="Caminhos alternativos (um por linha)" FontWeight="Bold"/>
                    <TextBox x:Name="FallbackBox" Margin="0,2,0,8" Height="52"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextChanged="FieldChanged"/>
                </StackPanel>

                <StackPanel x:Name="BuiltinPanel" Visibility="Collapsed">
                    <TextBlock Text="Ação do sistema" FontWeight="Bold"/>
                    <ComboBox x:Name="BuiltinBox" Margin="0,2,0,8"
                              SelectionChanged="BuiltinBox_SelectionChanged"/>
                </StackPanel>

                <TextBlock Text="Dica (tooltip)" FontWeight="Bold"/>
                <TextBox x:Name="TooltipBox" Margin="0,2,0,8" TextChanged="FieldChanged"/>

                <Button Content="▶ Testar este botão" Click="TestButton_Click"
                        Padding="8,6" Margin="0,8,0,0" MinHeight="30"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        </TabItem>

        <TabItem Header="Aparência">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,10,0" MaxWidth="340" HorizontalAlignment="Left">
                <TextBlock Text="Aplicado e salvo na hora." Opacity="0.7" Margin="0,0,0,10"/>
                <TextBlock Text="Tema" FontWeight="Bold"/>
                <ComboBox x:Name="ThemeBox" Margin="0,2,0,8"
                          SelectionChanged="AppearanceChanged">
                    <ComboBoxItem Content="Escuro"/>
                    <ComboBoxItem Content="Claro"/>
                </ComboBox>
                <TextBlock Text="Tamanho" FontWeight="Bold"/>
                <ComboBox x:Name="SizeBox" Margin="0,2,0,8"
                          SelectionChanged="AppearanceChanged">
                    <ComboBoxItem Content="Pequeno"/>
                    <ComboBoxItem Content="Médio"/>
                    <ComboBoxItem Content="Grande"/>
                </ComboBox>
                <TextBlock Text="Canto da tela" FontWeight="Bold"/>
                <ComboBox x:Name="CornerBox" Margin="0,2,0,8"
                          SelectionChanged="AppearanceChanged">
                    <ComboBoxItem Content="Inferior direito"/>
                    <ComboBoxItem Content="Inferior esquerdo"/>
                    <ComboBoxItem Content="Superior direito"/>
                    <ComboBoxItem Content="Superior esquerdo"/>
                </ComboBox>
                <TextBlock Text="Colunas de botões" FontWeight="Bold"/>
                <ComboBox x:Name="ColumnsBox" Margin="0,2,0,8"
                          SelectionChanged="AppearanceChanged">
                    <ComboBoxItem Content="1 coluna (ícone + nome)"/>
                    <ComboBoxItem Content="2 colunas (só ícones)"/>
                    <ComboBoxItem Content="1x — 8 botões + setas"/>
                    <ComboBoxItem Content="2x — 8 botões + setas"/>
                </ComboBox>
                <TextBlock Text="Ícones por página (8 ou 16)" FontWeight="Bold"/>
                <ComboBox x:Name="PageSizeBox" Margin="0,2,0,16"
                          SelectionChanged="PageSizeBox_Changed">
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="16"/>
                </ComboBox>
                <TextBlock Text="Opacidade do fundo" FontWeight="Bold"/>
                <DockPanel Margin="0,2,0,16">
                    <TextBlock x:Name="OpacityLabel" Text="80%" Width="44"
                               VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_Changed"/>
                </DockPanel>
                <TextBlock Text="Atalho global de teclado" FontWeight="Bold"/>
                <TextBox x:Name="HotkeyBox" Margin="0,2,0,0"
                         LostFocus="HotkeyBox_LostFocus" KeyDown="HotkeyBox_KeyDown"/>
                <TextBlock Text="Ex.: Ctrl+Alt+H. Vale ao sair do campo."
                           Opacity="0.7" FontSize="11" Margin="0,0,0,16"/>
                <TextBlock Text="Pomodoro (minutos)" FontWeight="Bold"/>
                <Grid Margin="0,2,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Foco" FontSize="11" Opacity="0.8"/>
                        <TextBox x:Name="FocusBox" LostFocus="PomoBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Pausa" FontSize="11" Opacity="0.8"/>
                        <TextBox x:Name="BreakBox" LostFocus="PomoBox_LostFocus"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Módulos no rodapé" FontWeight="Bold" Margin="0,0,0,2"/>
                <CheckBox x:Name="ShowPomoCheck" Content="Pomodoro"
                          Margin="0,2,0,2"
                          Checked="ModulesCheck_Changed" Unchecked="ModulesCheck_Changed"/>
                <CheckBox x:Name="ShowClipsCheck" Content="Clips (histórico do clipboard)"
                          Margin="0,2,0,0"
                          Checked="ModulesCheck_Changed" Unchecked="ModulesCheck_Changed"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Sobre">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,10,0" MaxWidth="340" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Image Source="pack://application:,,,/logo.png" Width="26" Height="26"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Nook" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" Text="v1.1.0" Opacity="0.7" Margin="0,0,0,10"/>
                <TextBlock Text="Seu cantinho na tela: atalhos, monitor do PC, pomodoro, histórico da área de transferência e turbo — tudo num cartão flutuante que nunca pede permissão de administrador."
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Licença" FontWeight="Bold"/>
                <TextBlock Text="Software livre (MIT) — use e modifique à vontade."
                           TextWrapping="Wrap" Margin="0,2,0,10"/>
                <TextBlock Text="Código-fonte" FontWeight="Bold"/>
                <TextBlock Margin="0,2,0,10">
                    <Hyperlink NavigateUri="https://github.com/XandeBritez/Nook"
                               RequestNavigate="RepoLink_RequestNavigate">github.com/XandeBritez/Nook</Hyperlink>
                </TextBlock>
                <TextBlock Text="Autor" FontWeight="Bold"/>
                <TextBlock Text="Alexandre Britez Borsuka" Margin="0,2,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Rodapé -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Salvar" Width="90" Padding="8,6" Margin="0,0,6,0"
                        IsDefault="True" Click="SaveButton_Click"/>
                <Button Content="Cancelar" Width="90" Padding="8,6"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
